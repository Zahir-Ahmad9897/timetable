# ============================================================================
# irid.ai Timetable — Production .gitignore
# Last updated: 2026-10-15
#
# Organized by category for SaaS-grade secret and artifact exclusion.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Dependencies & package-manager state
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/
.npm/
package-lock.json

# ---------------------------------------------------------------------------
# 2. Environment files & credentials
#    NEVER commit secrets. Only commit documented placeholder files.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.crt
*.cer
*.der
*.pfx
*.mobileprovision
*.jks
*.keystore
credentials.json
service-account*.json
google-services.json
GoogleService-Info.plist
.eas/
firebase*.json
!firebase.json.example

# API keys, tokens, and secrets that may be saved locally
**/secrets/
**/private/
server-data/
*.secret
*.token

# ---------------------------------------------------------------------------
# 3. Expo & React Native build artifacts
# ---------------------------------------------------------------------------
.expo/
dist/
dist-check/
.expo-export*/
web-build/
.test-build/
output/
tmp/
_archive/
android/.gradle/
android/app/build/
android/local.properties
ios/Pods/
ios/build/
ios/DerivedData/
*.hbc
*.bundle

# ---------------------------------------------------------------------------
# 4. Build & compilation output
# ---------------------------------------------------------------------------
build/
*.tsbuildinfo
*.js.map
coverage/
*.log
*.patch

# ---------------------------------------------------------------------------
# 5. Security tooling & audit output
# ---------------------------------------------------------------------------
security-reports/
*.sarif
audit-results/
vulnerability-reports/
.snyk
.trivyignore

# ---------------------------------------------------------------------------
# 6. Docker & container artifacts
# ---------------------------------------------------------------------------
docker-compose.override.yml
.docker/

# ---------------------------------------------------------------------------
# 7. IDE & editor configuration
#    Each developer should configure their own editor locally.
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------------------------------------------------------------------------
# 8. Operating system metadata
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------------------------------------------------------------------------
# 9. Local visual references (not shipped with the application)
# ---------------------------------------------------------------------------
ui design picture/

# ---------------------------------------------------------------------------
# 10. Testing & debugging artifacts
# ---------------------------------------------------------------------------
prompt.txt
__snapshots__/
*.snap
.jest/
jest.config.local.*

# ---------------------------------------------------------------------------
# 11. Deployment secrets & infrastructure state
# ---------------------------------------------------------------------------
*.tfstate
*.tfstate.backup
.terraform/
terraform.tfvars
*.auto.tfvars
pulumi.*.yaml
Pulumi.dev.yaml
kubeconfig*
helm-values-*.yaml

