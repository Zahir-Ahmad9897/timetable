{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": ["src/domain/**/*.ts"],
  "exclude": ["node_modules"]
}
