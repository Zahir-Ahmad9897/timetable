{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": [
    "src/domain/**/*.ts",
    "src/auth/__tests__/**/*.ts",
    "src/security/__tests__/**/*.ts",
    "src/subscription/__tests__/**/*.ts"
  ],
  "exclude": ["node_modules", "**/*.tsx"]
}
