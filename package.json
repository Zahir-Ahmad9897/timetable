{
  "name": "iridai-timetable-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=12.11.2 <13"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:tunnel:clear": "expo start --tunnel --clear",
    "start:lan": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "serve": "node --env-file-if-exists=.env server.js",
    "typecheck": "tsc --noEmit",
    "test:server": "node --test server/__tests__/*.test.js",
    "audit:security": "pnpm audit --prod --audit-level critical",
    "test": "tsc -p tsconfig.tests.json && node --test .test-build/src/domain/__tests__/*.test.js .test-build/src/auth/__tests__/*.test.js .test-build/src/security/__tests__/*.test.js .test-build/src/subscription/__tests__/*.test.js && pnpm run test:server",
    "check": "pnpm run typecheck && pnpm test",
    "start:mobile": "expo start --go --lan --no-dev --minify"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-picker/picker": "2.11.4",
    "expo": "~58.0.7",
    "expo-constants": "~58.0.10",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.8",
    "expo-font": "~58.0.7",
    "expo-haptics": "~58.0.5",
    "expo-linking": "~58.0.11",
    "expo-print": "~58.0.5",
    "expo-router": "~58.0.17",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.16",
    "expo-splash-screen": "~58.0.7",
    "expo-status-bar": "~58.0.3",
    "jsonwebtoken": "^9.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.29.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0",
    "stripe": "23.0.0",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "postcss": "8.5.18",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@12.11.2"
}
