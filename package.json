{
  "name": "iridai-timetable-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:tunnel:clear": "expo start --tunnel --clear",
    "start:lan": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --test .test-build/src/domain/__tests__/*.test.js",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-picker/picker": "2.11.4",
    "expo": "~57.0.27",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.4",
    "@types/react-native": "^0.72.8",
    "typescript": "~6.0.3"
  }
}
