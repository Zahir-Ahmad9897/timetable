{
  "expo": {
    "name": "irid.ai Timetable",
    "slug": "iridai-timetable",
    "scheme": "iridai-timetable",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/app-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.irid.timetable"
    },
    "android": {
      "package": "ai.irid.timetable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B5D43"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "baseUrl": "/timetable",
      "typedRoutes": true
    },
    "plugins": [
      "expo-document-picker",
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7F6",
          "dark": {
            "backgroundColor": "#09090B"
          }
        }
      ],
      "expo-secure-store"
    ]
  }
}
