# ============================================================================
# irid.ai Timetable — Environment Configuration
#
# Copy this file to `.env` and fill in production values.
# NEVER commit the `.env` file — it is excluded by .gitignore.
#
# All variables are validated at startup by src/config/environment.ts.
# Missing required variables will cause a clear error message.
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_VERSION=1.0.0
APP_BASE_URL=http://localhost:3000
APP_BASE_PATH=/timetable

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
AUTH_JWT_ISSUER=iridai-timetable
AUTH_JWT_AUDIENCE=iridai-timetable-clients
AUTH_ACCESS_TOKEN_EXPIRY_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRY_DAYS=30
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15

# ---------------------------------------------------------------------------
# Subscription & Billing (Stripe)
# ---------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_PRO_MONTHLY_PRICE_ID=price_REPLACE
STRIPE_PRO_YEARLY_PRICE_ID=price_REPLACE
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_REPLACE
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_REPLACE

# ---------------------------------------------------------------------------
# Database (PostgreSQL — for future SaaS backend)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/iridai_timetable
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Redis (Session store & rate limiting)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Comma-separated allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Content Security Policy nonce prefix
CSP_NONCE_PREFIX=iridai

# ---------------------------------------------------------------------------
# Email (Transactional — password reset, subscription receipts)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@irid.ai
SMTP_PASSWORD=REPLACE
SMTP_FROM_NAME=irid.ai Timetable
SMTP_FROM_EMAIL=noreply@irid.ai

# ---------------------------------------------------------------------------
# Logging & Monitoring
# ---------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
AUDIT_LOG_ENABLED=true

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
TLS_CERT_PATH=
TLS_KEY_PATH=
